# ---------------------------------------------------------------------------
# BLINDFOLD sound system - environment
# Copy this file to `.env.local` and fill in the values.
# On Vercel/Netlify add the same keys in the dashboard (Environment Variables).
# ---------------------------------------------------------------------------

# 1) REQUIRED - the primary database (PostgreSQL).
#    This app keeps the catalogue here and uses Firebase as the cloud mirror.
#    Supabase / Neon / Railway / any Postgres 14+ works.
#    Supabase: Project Settings -> Database -> Connection string (URI)
#
#    Tip: the direct host (db.<ref>.supabase.co) is IPv6-only. If your machine
#    has no IPv6, use the pooler instead:
#      postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#    Serverless hosts (Vercel/Netlify) are happier with the transaction pooler
#    on port 6543.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# 2) Admin console password (optional - the built-in default already works).
ADMIN_PASSWORD=Kashifmax11223344

# 3) Audio storage.
#    Serverless hosts have a read-only filesystem, so uploads must live in the
#    cloud. Supabase Storage is free (1 GB) and needs only the service-role key.
#    Supabase: Project Settings -> API -> service_role secret
#    The bucket (default "blndfld-audio") is created automatically on the first
#    upload. SUPABASE_URL is derived from DATABASE_URL when omitted.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_STORAGE_BUCKET=blndfld-audio
#
#    Leave the key empty to keep files on this machine's disk (development).
#    Force a backend explicitly if needed:
# STORAGE_DRIVER=supabase   # or: local

# 4) Firebase cloud mirror (server-side Admin SDK).
#    Easiest: paste the whole service-account JSON as one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

#    ...or use the three fields separately (same values as the JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# 5) Firebase Cloud Storage bucket.
#    Optional: needs the Blaze plan. Leave empty to keep audio in Supabase
#    Storage / on disk and mirror only the catalogue into Firestore.
FIREBASE_STORAGE_BUCKET=

# 6) Firestore database id. Usually "(default)". Some projects are created with
#    a named database instead - then use its id (e.g. "default").
FIREBASE_FIRESTORE_DATABASE=(default)
